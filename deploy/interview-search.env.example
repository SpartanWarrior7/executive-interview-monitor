# Copy to /etc/interview-search.env on the droplet, fill in, then lock it down:
#   sudo chown root:root /etc/interview-search.env
#   sudo chmod 600 /etc/interview-search.env
#
# systemd reads this file as root before dropping to the service user, so the
# app never needs read access to it.
#
# No quotes, no export, no spaces around the '='.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Optional. Omit YOUTUBE_API_KEY entirely to run without YouTube - the UI will
# show it struck through rather than failing.


# ---------------------------------------------------------------------------
# Email digest. Required only for the scheduled interview-digest job.
# ---------------------------------------------------------------------------
# Who it comes from and goes to. EMAIL_FROM must be a real mailbox in the
# tenant that the app is allowed to send as.
EMAIL_FROM=alerts@example.org
EMAIL_TO=you@example.com

# --- Microsoft Graph (preferred: no mailbox password anywhere) --------------
# From the Azure app registration (Entra ID -> App registrations):
#   GRAPH_TENANT_ID      Overview -> Directory (tenant) ID
#   GRAPH_CLIENT_ID      Overview -> Application (client) ID
#   GRAPH_CLIENT_SECRET  Certificates & secrets -> the secret VALUE, not the ID
#
# In Exchange Online, assign the app the Application Mail.Send role through
# Application RBAC and scope it to EMAIL_FROM. Do not also leave an unscoped
# Graph Mail.Send application grant in Entra; the grants are additive and the
# Entra grant would allow every mailbox.
#
# Client secrets expire - note the expiry date when you create it, or the
# digest will stop one morning with an invalid_client error.

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- SMTP (fallback; leave blank when using Graph) --------------------------
# SMTP_SECURITY is starttls (port 587) or ssl (port 465); SMTP_PORT follows.
#   Gmail     smtp.gmail.com with an App Password, not the account password
#   SendGrid  smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=<api key>

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls

# Force a backend if both are configured: graph | smtp. Blank auto-detects.
EMAIL_BACKEND=


# ---------------------------------------------------------------------------
# Changing the tracked list by replying to the digest (interview-commands).
# ---------------------------------------------------------------------------
# The mailbox to read instructions from - normally the same one the digest is
# sent from. Leaving this blank switches the whole feature off, including the
# "reply to change this list" footer in the digest.
#
# Graph only: reading needs Mail.ReadWrite as well as Mail.Send. Grant it the
# same way - the Application Mail.ReadWrite role through Exchange Application
# RBAC, scoped to this mailbox. Nothing goes in Entra; an application permission
# there covers every mailbox and, being additive, would defeat the scope. See
# deploy/DEPLOY.md section 9.

COMMAND_MAILBOX=alerts@example.org

# Which folder of that mailbox to read. Defaults to inbox. Change it only if
# an Outlook rule moves the replies somewhere else - a reply in a folder this
# never reads is never applied, and nothing reports that. Takes a well-known
# name (inbox, archive) or a folder id.
COMMAND_FOLDER=inbox

# Who is allowed to give instructions, comma-separated. Defaults to EMAIL_TO.
# A shared mailbox accepts mail from anyone and From: is trivially forged, so
# mail is also required to pass DMARC before it is acted on.
COMMAND_SENDERS=you@example.com

# Where the tracked-executive list lives. Point this at state/ so that the
# email handler can write it: the repo copy is tracked in git and would
# conflict with every `git pull`.
WATCHLIST_PATH=/opt/interview-monitor/state/executives.json
