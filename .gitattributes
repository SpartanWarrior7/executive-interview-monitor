# These files are consumed on Linux. Without this, a Windows checkout gives
# them CRLF endings and systemd/Caddy/nginx choke on the trailing \r.
deploy/**        text eol=lf
*.service        text eol=lf
*.snippet        text eol=lf
*.conf           text eol=lf
*.sh             text eol=lf

# Batch files are consumed by cmd.exe and need CRLF.
*.bat            text eol=crlf
*.cmd            text eol=crlf
